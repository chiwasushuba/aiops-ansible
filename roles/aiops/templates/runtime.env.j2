{% set aiops_environment = {
  'DB_URL': 'jdbc:postgresql://db:5432/' ~ aiops_postgres_db,
  'DB_USERNAME': aiops_postgres_user,
  'DB_PASSWORD': aiops_postgres_password,
  'AIOPS_OWNER_LOGIN': aiops_owner_login,
  'AIOPS_OWNER_PASSWORD_HASH': aiops_owner_password_hash,
  'AIOPS_OWNER_NAME': aiops_owner_name,
  'AIOPS_OWNER_TIMEZONE': aiops_owner_timezone,
  'AIOPS_ALLOWED_ORIGIN': aiops_frontend_origin,
  'OPENAI_API_KEY': aiops_openai_api_key,
  'OPENAI_MODEL': aiops_openai_model,
  'OPENAI_MAX_OUTPUT_TOKENS': aiops_openai_max_output_tokens,
  'OPENAI_DAILY_RUN_LIMIT': aiops_openai_daily_run_limit,
  'AIOPS_GMAIL_CLIENT_ID': aiops_gmail_client_id,
  'AIOPS_GMAIL_CLIENT_SECRET': aiops_gmail_client_secret,
  'AIOPS_GMAIL_TOKEN_KEY': aiops_gmail_token_key,
  'AIOPS_GMAIL_REDIRECT_URI': 'https://' ~ aiops_api_domain ~ '/api/connections/gmail/callback'
} %}
{% for key, value in aiops_environment.items() %}
{{ key }}={{ value }}
{% endfor %}

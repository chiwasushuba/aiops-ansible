#!/usr/bin/env sh
set -eu
# Preserve Oracle's OUTPUT/iSCSI rules, SSH rules and Docker's forwarding chains.
# Match the rule managed by ansible.builtin.iptables; add it only if missing.
for tool in /usr/sbin/iptables /usr/sbin/ip6tables; do
    "$tool" -w 10 -C INPUT -p tcp -m multiport --dports 80,443 -m comment --comment 'AIOps HTTP and HTTPS ingress' -j ACCEPT 2>/dev/null ||
        "$tool" -w 10 -I INPUT 1 -p tcp -m multiport --dports 80,443 -m comment --comment 'AIOps HTTP and HTTPS ingress' -j ACCEPT
done
